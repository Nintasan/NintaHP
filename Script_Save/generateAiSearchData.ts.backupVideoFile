    // idleTimeout: MySQLのwait_timeoutの90%に設定（デフォルト8時間 → 7時間）
    idleTimeout: 25200000, // 7時間 (25,200秒)
    maxIdle: 10, // 最大アイドル接続数
  });

  let success = 0, failed = 0; // グローバルスコープに移動

  try {
    const conn = await pool.getConnection();
    try {
      const posts = await fetchPosts(conn);
      console.log(`Found ${posts.length} posts to process\n`);

      for (let i = 0; i < posts.length; i++) {
        if (rateLimitReached) {
          console.log(`\n⚠️  残り ${posts.length - i} 件のポストをスキップしました`);
          break;
        }

        const post = posts[i];
        console.log(`[${i + 1}/${posts.length}] Processing: ${post.id}`);
        console.log(`Source: ${post.source}`);

        try {
          // 各処理で新しい接続を取得
          const processConn = await pool.getConnection();
          try {
            await processPost(processConn, post);
          } finally {
            processConn.release();
          }
          const apiType = usingPaidAPI ? 'PAID' : 'FREE';
          console.log(`✅ Success (using ${usingPaidAPI ? 'PAID 💰' : 'FREE 🆓'} API)\n`);
          success++;

          // ログ記録
          logToCSV(post.id, post.source, 'success', apiType);

          // 成功時: エラーカウントをリセット、スリープ時間を徐々に短縮
          rateLimitState.consecutiveErrors = 0;
          rateLimitState.currentSleepTime = Math.max(
            rateLimitState.currentSleepTime * 0.9,
            rateLimitState.baseSleepTime
          );

          // バッチ処理: 50件ごとに2分休憩
          if ((i + 1) % 50 === 0 && i + 1 < posts.length) {
            console.log(`\n${'='.repeat(70)}`);
            console.log(`📊 Batch checkpoint: ${i + 1}/${posts.length} processed`);
            console.log(`⏸️  Taking a 2-minute rest to avoid rate limits...`);
            console.log(`${'='.repeat(70)}\n`);
            await sleep(120000); // 2分休憩
          } else {
            await sleep(rateLimitState.currentSleepTime);
          }
        } catch (error: any) {
          const shouldStop = await handleRateLimitError(error, `Post ${i + 1}/${posts.length}`);
          if (shouldStop) { failed++; break; }

          if (usingPaidAPI) {
            console.log(`🔄 Retrying with PAID API...`);
            try {
              const retryConn = await pool.getConnection();
              try {
                await processPost(retryConn, post);
              } finally {
                retryConn.release();
              }
              console.log(`✅ Success (using PAID 💰 API)\n`);
              success++;

              // 成功時リセット
              rateLimitState.consecutiveErrors = 0;
              await sleep(rateLimitState.currentSleepTime);
              continue;
            } catch (retryError: any) {
              const isRateLimit = checkRateLimitError(retryError);
              if (isRateLimit) {
                // リトライでもレート制限なら再度待機
                await handleRateLimitError(retryError, `Retry Post ${i + 1}/${posts.length}`);
                // もう一度リトライ
                try {
                  const finalRetryConn = await pool.getConnection();
                  try {
                    await processPost(finalRetryConn, post);
                  } finally {
                    finalRetryConn.release();
                  }
                  console.log(`✅ Success after extended wait (using PAID 💰 API)\n`);
                  success++;
                  rateLimitState.consecutiveErrors = 0;
                  await sleep(rateLimitState.currentSleepTime);
                  continue;
                } catch (finalError: any) {
                  console.error(`❌ Failed after multiple retries: ${finalError.message}\n`);
                  logToCSV(post.id, post.source, 'failed', 'PAID', finalError.message);
                  failed++;
                  continue;
                }
              }
              console.error(`❌ Failed even with PAID API: ${retryError.message}\n`);
              logToCSV(post.id, post.source, 'failed', 'PAID', retryError.message);
              failed++;
              continue;
            }
          }
          console.error(`❌ Failed: ${error.message}\n`);
          logToCSV(post.id, post.source, 'failed', usingPaidAPI ? 'PAID' : 'FREE', error.message);
          failed++;
          await sleep(rateLimitState.currentSleepTime);
        }
      }

      console.log('='.repeat(70));
      console.log(`✅ Success: ${success} | ❌ Failed: ${failed} | 📊 Total: ${posts.length}`);
      if (rateLimitReached) console.log('⚠️  Status: STOPPED (Rate Limit Reached)');

      // コスト情報を表示
      if (sessionCost.totalCostUSD > 0) {
        console.log('');
        console.log('💰 Cost Summary (Paid API):');
        console.log(`   Input Tokens:  ${sessionCost.inputTokens.toLocaleString()}`);
        console.log(`   Output Tokens: ${sessionCost.outputTokens.toLocaleString()}`);
        console.log(`   Video Seconds: ${sessionCost.videoSeconds.toFixed(1)}s`);
        console.log(`   Images:        ${sessionCost.images}`);
        console.log(`   Total Cost:    ${formatCost(sessionCost.totalCostUSD)}`);
      }

      console.log('='.repeat(70));
    } finally {
      conn.release();
    }

    await pool.end();
    process.exit(rateLimitReached ? 2 : (failed > 0 ? 1 : 0));
  } catch (error) {
    console.error('Fatal error:', error);
    await pool.end();
    process.exit(1);
  }
}

async function fetchPosts(conn: mysql.Connection): Promise<Post[]> {
  if (postId) {
    const [rows] = await conn.query('SELECT id, source FROM posts WHERE id = ?', [postId]);
    return rows as Post[];
  }

  let query = `SELECT id, source FROM posts WHERE source IS NOT NULL`;

  // --skip-processed オプション: 処理済みをスキップ
  if (skipProcessed) {
    query += ` AND (ai_processed_at IS NULL OR summary IS NULL)`;
  }

  if (postNumFrom || postNumTo) {
    const conditions: string[] = [];
    if (postNumFrom) conditions.push(`post_num >= ${parseInt(postNumFrom)}`);
    if (postNumTo) conditions.push(`post_num <= ${parseInt(postNumTo)}`);
    if (conditions.length > 0) query += ` AND (${conditions.join(' AND ')})`;
  }

  query += ` ORDER BY post_num ASC`;
  if (limit) query += ` LIMIT ${limit}`;

  const [rows] = await conn.query(query);
  return rows as Post[];
}

async function processPost(conn: mysql.Connection, post: Post) {
  const url = post.source;

  // 既存タグを取得（統合AI処理で使用）
  const [tagRows] = await conn.query(`SELECT DISTINCT t.name FROM tags t INNER JOIN r_tags rt ON t.id = rt.tag_id WHERE rt.item_type = 'post'`);
  const existingTags = (tagRows as any[]).map(r => r.name);

  if (isTwitterUrl(url)) {
    await processTwitter(conn, post.id, url, existingTags);
  } else if (isYouTubeUrl(url)) {
    await processYouTube(conn, post.id, url, existingTags);
  } else {
    console.log('  ⚠️  Unknown URL type');
    return;
  }
}

async function processTwitter(conn: mysql.Connection, postId: string, url: string, existingTags: string[]) {
  console.log('  📱 Fetching Twitter data...');
  const data = await getTwitterFullData(url);
  if (!data?.text) throw new Error('No Twitter data');

  // 🎯 STEP 1: 全データ収集（Gemini呼び出し前）
  const media = data.media || [];
  let allImageAnalysis: string[] = [];
  let allVideoAnalysis: string[] = [];

  console.log('  📊 Collecting all media analysis...');

  // 画像解析
  const images = media.filter(m => m.type === 'photo' && m.url);
  for (const img of images) {
    try {
      console.log(`  🖼️  Analyzing image ${images.indexOf(img) + 1}/${images.length}...`);
      const analysis = await analyzeImageCombined(img.url);
      if (analysis) allImageAnalysis.push(analysis);
      await sleep(5000);
    } catch (err: any) {
      const shouldStop = await handleRateLimitError(err, 'Image analysis');
      if (shouldStop) throw err;
    }
  }

  // 動画解析（投稿テキストを含める）
  const videos = media.filter(m => (m.type === 'video' || m.type === 'animated_gif') && m.url);
  let videoAnalysisFailed = false;
  let videoAnalysisErrors: string[] = [];
  let twitterVideoCost = 0;
  const videoCleanupFunctions: Array<() => Promise<void>> = [];
  for (const video of videos) {
    try {
      console.log(`  🎬 Analyzing video ${videos.indexOf(video) + 1}/${videos.length}...`);
      const { analysis: videoAnalysis, cost, cleanup } = await analyzeTwitterVideoWithSegmentation(video.url, data.text);
      twitterVideoCost += cost;
      if (cleanup) videoCleanupFunctions.push(cleanup);
      if (videoAnalysis) {
        allVideoAnalysis.push(videoAnalysis);
      } else {
        videoAnalysisFailed = true;
        videoAnalysisErrors.push(`Video ${videos.indexOf(video) + 1}: returned empty result`);
      }
      await sleep(5000);
    } catch (err: any) {
      const shouldStop = await handleRateLimitError(err, 'Video analysis');
      if (shouldStop) throw err;
      videoAnalysisFailed = true;
      videoAnalysisErrors.push(`Video ${videos.indexOf(video) + 1}: ${err.message.substring(0, 150)}`);
    }
  }

  // Twitter動画解析コストを表示
  if (twitterVideoCost > 0) {
    console.log(`     💰 Twitter video analysis cost: ${formatCost(twitterVideoCost)}`);
