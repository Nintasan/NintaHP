    // 🗑️ すべての処理が成功した後に動画ファイルをクリーンアップ
    for (const cleanup of videoCleanupFunctions) {
      try {
        await cleanup();
      } catch (e) {
        console.error(`     ⚠️  Cleanup error: ${e}`);
      }
    }
  } catch (error) {
    await conn.rollback();
    throw error;
  }
}

async function processYouTube(conn: mysql.Connection, postId: string, url: string, existingTags: string[]) {
  console.log('  🎥 Fetching YouTube data...');
  const videoIdMatch = url.match(/(?:embed\/|v=|\/)([\w-]{11})/);
  if (!videoIdMatch) throw new Error('Invalid YouTube URL');

  const videoId = videoIdMatch[1];
  const resp = await youtube.videos.list({ part: ['snippet', 'statistics', 'contentDetails'], id: [videoId] });
  if (!resp.data.items?.length) throw new Error('Video not found');

  const video = resp.data.items[0];
  const snippet = video.snippet!;

  // 動画の長さを計算（秒）
  const durationStr = video.contentDetails?.duration;
  let durationSeconds = 0;
  if (durationStr) {
    const match = durationStr.match(/PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?/);
    durationSeconds = parseInt(match?.[1] || '0') * 3600 + parseInt(match?.[2] || '0') * 60 + parseInt(match?.[3] || '0');
  }

  // 🎯 STEP 1: 全データ収集（Gemini呼び出し前）
  console.log('  📊 Collecting all content...');

  // ソーステキスト
  const combined = (snippet.title || '') && (snippet.description || '') ? `${snippet.title}\n\n${snippet.description}` : (snippet.title || snippet.description || '');

  // 字幕取得
  let transcriptText = '';
  try {
    console.log('  📝 Fetching transcript...');
    const transcript = await YoutubeTranscript.fetchTranscript(videoId);
    if (transcript?.length) {
      transcriptText = transcript.map((item: any) => item.text).join(' ');
      console.log(`     📊 Original transcript: ${transcriptText.length} chars`);
    } else {
      console.log(`  ⚠️  No transcript available`);
    }
  } catch (err: any) {
    console.log(`  ⚠️  Transcript fetch failed: ${err.message.substring(0, 50)}`);
  }

  // 動画解析（メタデータなし - 純粋な動画解析のみ）
  let videoAnalysis = '';
  let videoAnalysisFailed = false;
  let videoAnalysisError = '';
  let videoAnalysisCost = 0;
  let youtubeVideoCleanup: (() => Promise<void>) | undefined;
  try {
    console.log('  🎬 Analyzing YouTube video with Gemini...');
    const youtubeUrl = `https://www.youtube.com/watch?v=${videoId}`;
    const { analysis, cost, cleanup } = await analyzeYouTubeVideoByUrl(youtubeUrl, durationSeconds);
    if (cleanup) youtubeVideoCleanup = cleanup;
    if (analysis) {
      videoAnalysis = analysis;
      videoAnalysisCost = cost;
      if (usingPaidAPI && cost > 0) {
        console.log(`     💰 Video analysis cost: ${formatCost(cost)}`);
      }
    } else {
      videoAnalysisFailed = true;
      videoAnalysisError = 'Video analysis returned empty result';
    }
    await sleep(5000);
  } catch (err: any) {
    const shouldStop = await handleRateLimitError(err, 'YouTube video analysis');
    if (shouldStop) throw err;
    videoAnalysisFailed = true;
    videoAnalysisError = err.message.substring(0, 200);
    console.log(`  ⚠️  Video analysis failed: ${err.message.substring(0, 50)}`);
  }

  // 🤖 STEP 2: 統合AI処理（1回のGeminiリクエスト）
  console.log('  🤖 Running unified AI processing...');
  const charLimit = getTranscriptCharLimit(durationSeconds);
  const aiResult = await processWithUnifiedAI({
    sourceText: combined,
    transcript: transcriptText,
    transcriptCharLimit: charLimit,
    videoAnalysis: videoAnalysis,
    existingTags: existingTags,
    mediaType: 'youtube'
  });

  // 🗄️ STEP 3: データベース保存
  // 長時間の動画処理後、接続の有効性を確認
  try {
    await conn.ping();
  } catch (pingError: any) {
    throw new Error(`Database connection lost during processing: ${pingError.message}. Please retry.`);
  }

  await conn.beginTransaction();
  try {
    // Metadata更新（動画解析失敗情報を含める）
    const metadata: any = {
      media: 'YouTube',
      youtube: {
        channel_id: snippet.channelId,
        video_id: videoId,
        category_id: snippet.categoryId,
        published_at: snippet.publishedAt,
        tags: snippet.tags || [],
        duration: video.contentDetails?.duration,
      }
    };

    // 動画解析失敗時に記録
    if (videoAnalysisFailed) {
      metadata.youtube.video_analysis_failed = true;
      metadata.youtube.video_analysis_error = videoAnalysisError;
      metadata.youtube.video_analysis_failed_at = new Date().toISOString();
    }

    await conn.query('UPDATE posts SET metadata = ? WHERE id = ?', [JSON.stringify(metadata), postId]);

    await conn.query('DELETE FROM post_chunks WHERE post_id = ?', [postId]);
    let idx = 0;

    // 匿名化されたテキストを保存
    const textChunks = createChunks(aiResult.anonymizedText, 600);
    for (const chunk of textChunks) {
      await saveChunk(conn, postId, idx++, chunk, 'YouTube', 'text_content', 'youtube_text');
    }
    console.log(`  ✅ Saved ${textChunks.length} text chunks (AI processed)`);

    // 処理済み字幕を保存
    if (aiResult.processedTranscript) {
      console.log(`     ✅ Processed transcript: ${aiResult.processedTranscript.length} chars`);
      const transcriptChunks = createChunks(aiResult.processedTranscript, 600);
      for (const chunk of transcriptChunks) {
        await saveChunk(conn, postId, idx++, chunk, 'YouTube', 'video_translation', 'youtube_sub');
      }
      console.log(`  ✅ Saved ${transcriptChunks.length} transcript chunks (AI processed)`);
    }

    // 動画解析結果を保存
    if (videoAnalysis) {
      const analysisChunks = splitIntoChunksWithOverlap(videoAnalysis, 600);
      for (const chunk of analysisChunks) {
        await saveChunk(conn, postId, idx++, chunk, 'YouTube', 'video_analysis', 'youtube_video');
      }
      console.log(`  ✅ Saved ${analysisChunks.length} video analysis chunks`);
    }

    // AI Fieldsを保存
    await conn.query(
      `UPDATE posts SET summary = ?, ai_tags = ?, ai_title = ?, user_intent = ?, total_chunks = ?, ai_processed_at = NOW() WHERE id = ?`,
      [aiResult.summary, JSON.stringify(aiResult.ai_tags), aiResult.ai_title, JSON.stringify(aiResult.user_intent), idx, postId]
    );
    console.log(`  ✅ AI fields saved (Title: ${aiResult.ai_title.substring(0, 30)}...)`);

    await conn.commit();

    // 🗑️ すべての処理が成功した後にYouTube動画ファイルをクリーンアップ
    if (youtubeVideoCleanup) {
      try {
        await youtubeVideoCleanup();
      } catch (e) {
        console.error(`     ⚠️  Cleanup error: ${e}`);
      }
    }
  } catch (error) {
    await conn.rollback();
    throw error;
  }
}

