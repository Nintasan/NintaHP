  if (!fs.existsSync(LOG_FILE)) {
    const header = 'timestamp,post_id,source,status,api_type,error,cost_usd\n';
    fs.writeFileSync(LOG_FILE, header);
  }
}

function logToCSV(postId: string, source: string, status: 'success' | 'failed', apiType: string, error: string = '', costUsd: number = 0) {
