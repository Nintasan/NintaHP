    mediaType: 'twitter'
  });

  // 🗄️ STEP 3: データベース保存
  // 長時間の動画処理後、接続の有効性を確認
  try {
    await conn.ping();
  } catch (pingError: any) {
    throw new Error(`Database connection lost during processing: ${pingError.message}. Please retry.`);
  }

  await conn.beginTransaction();
  try {
    // Metadata更新（動画解析失敗情報を含める）
    const metadata: any = {
      media: 'Twitter',
      twitter: {
        user_id: data.user_id,
        tweet_id: data.tweet_id,
        date: data.date,
        has_gif: media.some(m => m.type === 'animated_gif'),
        has_image: media.some(m => m.type === 'photo'),
        has_video: media.some(m => m.type === 'video'),
        media_count: media.length,
      }
    };

    // 動画解析失敗時に記録
    if (videoAnalysisFailed) {
      metadata.twitter.video_analysis_failed = true;
      metadata.twitter.video_analysis_errors = videoAnalysisErrors;
      metadata.twitter.video_analysis_failed_at = new Date().toISOString();
    }

    await conn.query('UPDATE posts SET metadata = ? WHERE id = ?', [JSON.stringify(metadata), postId]);

    await conn.query('DELETE FROM post_chunks WHERE post_id = ?', [postId]);
    let idx = 0;

    // 匿名化されたテキストを保存
    const textChunks = createChunks(aiResult.anonymizedText, 600);
    for (const chunk of textChunks) {
      await saveChunk(conn, postId, idx++, chunk, 'Twitter', 'text_content', 'twitter_post');
    }
    console.log(`  ✅ Saved ${textChunks.length} text chunks (AI processed)`);

    // 画像解析結果を保存
    for (const analysis of allImageAnalysis) {
      const imageChunks = splitIntoChunksWithOverlap(analysis, 600);
      for (const chunk of imageChunks) {
        await saveChunk(conn, postId, idx++, chunk, 'Twitter', 'image_analysis', 'twitter_image');
      }
    }

    // 動画解析結果を保存
    for (const analysis of allVideoAnalysis) {
      const videoChunks = splitIntoChunksWithOverlap(analysis, 600);
      for (const chunk of videoChunks) {
        await saveChunk(conn, postId, idx++, chunk, 'Twitter', 'video_analysis', 'twitter_video');
      }
    }

    // AI Fieldsを保存
    await conn.query(
      `UPDATE posts SET summary = ?, ai_tags = ?, ai_title = ?, user_intent = ?, total_chunks = ?, ai_processed_at = NOW() WHERE id = ?`,
      [aiResult.summary, JSON.stringify(aiResult.ai_tags), aiResult.ai_title, JSON.stringify(aiResult.user_intent), idx, postId]
    );
    console.log(`  ✅ AI fields saved (Title: ${aiResult.ai_title.substring(0, 30)}...)`);

