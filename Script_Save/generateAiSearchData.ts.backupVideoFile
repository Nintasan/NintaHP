/**
 * テキストから個人情報を匿名化する
 * - ユーザー名（@username）
 * - チャンネル名
 * - メールアドレス
 * - URL内の個人識別子
 */
function anonymizeText(text: string, context: 'twitter' | 'youtube' = 'twitter'): string {
  if (!text) return text;

  let anonymized = text;

  // Twitterユーザー名の匿名化: @username → [USER]
  anonymized = anonymized.replace(/@[\w_]{1,15}\b/g, '[USER]');

  // メールアドレスの匿名化
  anonymized = anonymized.replace(/[\w.+-]+@[\w.-]+\.[a-zA-Z]{2,}/g, '[EMAIL]');

  // YouTube固有: チャンネル名のパターン（"by ChannelName", "ChannelName official"など）
  if (context === 'youtube') {
    // "by <Name>" パターン
    anonymized = anonymized.replace(/\bby\s+[A-Z][\w\s]{2,30}(?=\s|$|\.)/g, 'by [CREATOR]');
    // チャンネル署名パターン（末尾の - ChannelName など）
    anonymized = anonymized.replace(/[-–—]\s*[A-Z][\w\s]{2,30}\s*$/gm, '- [CREATOR]');
  }

  // URL内の個人識別子を匿名化（twitter.com/username, youtube.com/@channelなど）
  anonymized = anonymized.replace(/(twitter\.com|x\.com)\/[\w_]+/g, '$1/[USER]');
  anonymized = anonymized.replace(/youtube\.com\/@[\w-]+/g, 'youtube.com/@[CHANNEL]');
  anonymized = anonymized.replace(/youtube\.com\/c\/[\w-]+/g, 'youtube.com/c/[CHANNEL]');
  anonymized = anonymized.replace(/youtube\.com\/channel\/[\w-]+/g, 'youtube.com/channel/[CHANNEL]');

  return anonymized;
}

/**
 * 動画の長さに応じた字幕のハードキャップを計算
 */
function getTranscriptCharLimit(durationSeconds: number): number {
  const minutes = durationSeconds / 60;
  if (minutes < 10) return 2400;
  if (minutes < 30) return 4800;
  if (minutes < 60) return 7200;
  return 12000;
}

/**
 * 統合AI処理: 1回のGeminiリクエストで全ての処理を実行
 * - テキスト匿名化
 * - 字幕要約 & 匿名化
 * - AI Fields生成 (summary, ai_tags, ai_title, user_intent)
 */
interface UnifiedAIInput {
  sourceText?: string;  // Twitter/YouTubeの生テキスト
  transcript?: string;  // YouTube字幕
  transcriptCharLimit?: number;
  videoAnalysis?: string;  // 映像解析結果
  imageAnalysis?: string;  // 画像解析結果
  existingTags?: string[];  // 既存タグ
  mediaType: 'twitter' | 'youtube';
}

interface UnifiedAIOutput {
  anonymizedText: string;  // 匿名化されたテキスト
  processedTranscript?: string;  // 要約 & 匿名化された字幕
  ai_title: string;
  summary: string;
  ai_tags: string[];
  user_intent: string[];
}

async function processWithUnifiedAI(input: UnifiedAIInput): Promise<UnifiedAIOutput> {
  try {
    console.log(`     🔧 Using ${usingPaidAPI ? 'PAID 💰 (Vertex AI)' : 'FREE 🆓 (AI Studio)'} API for unified processing`);
    const model = getGeminiModel();

    // 既存タグの文字列化
    const existingTagsStr = input.existingTags && input.existingTags.length > 0
      ? `\n\nExisting tags in database (prioritize these): ${input.existingTags.join(', ')}`
      : '';

    // 統合プロンプトを構築
    let contentSections = [];

    if (input.sourceText) {
      contentSections.push(`=== SOURCE TEXT (${input.mediaType.toUpperCase()}) ===\n${input.sourceText.substring(0, 5000)}`);
    }

    if (input.transcript) {
      contentSections.push(`=== VIDEO TRANSCRIPT (RAW) ===\n${input.transcript.substring(0, 50000)}`);
    }

    if (input.videoAnalysis) {
      contentSections.push(`=== VIDEO ANALYSIS ===\n${input.videoAnalysis.substring(0, 10000)}`);
    }

    if (input.imageAnalysis) {
      contentSections.push(`=== IMAGE ANALYSIS ===\n${input.imageAnalysis.substring(0, 5000)}`);
    }

    const prompt = `Process this Live2D/VTuber content and return a comprehensive JSON response:

${contentSections.join('\n\n')}
${existingTagsStr}

TASK 1: Anonymize source text
- Remove all personal information (names, usernames, channels, emails, URLs with usernames)
- Replace with generic placeholders like [USER], [CREATOR], [CHANNEL], [EMAIL]

TASK 2: Summarize & anonymize transcript (if provided)
- Extract ONLY technical content related to Live2D/VTuber
- Remove filler words and casual conversation
- Remove personal information
- Maximum ${input.transcriptCharLimit || 12000} characters
- If no technical content, use anonymized original

TASK 3: Generate metadata
- ai_title: Concise 10-15 word title in English
- summary: 300-character summary covering technical points and context
- ai_tags: EXACTLY 5 tags maximum - choose the MOST IMPORTANT tags that clearly identify what this post is about (prioritize existing tags, use lowercase_underscore format)
- user_intent: 3 practical technical questions this content answers

Return ONLY this JSON structure:
{
  "anonymized_text": "anonymized source text here",
  "processed_transcript": "summarized and anonymized transcript here (or empty if no transcript)",
  "ai_title": "title here",
  "summary": "summary here",
  "ai_tags": ["tag1", "tag2", ...],
  "user_intent": ["question1", "question2", "question3"]
}

CRITICAL: All output must be in English. NO personal identifiers allowed.`;

    const result = await callGenerateContent(model, [{ text: prompt }]);
    const responseText = getTextFromResponse(result);

    // JSONを抽出
    const jsonMatch = responseText.match(/\{[\s\S]*\}/);
    if (!jsonMatch) {
      throw new Error('Failed to parse AI response JSON');
    }

    const parsed = JSON.parse(jsonMatch[0]);

    return {
      anonymizedText: parsed.anonymized_text || anonymizeText(input.sourceText || '', input.mediaType),
      processedTranscript: parsed.processed_transcript || (input.transcript ? anonymizeText(input.transcript.substring(0, input.transcriptCharLimit || 12000), 'youtube') : undefined),
      ai_title: parsed.ai_title || '',
      summary: parsed.summary || '',
      ai_tags: (parsed.ai_tags || []).slice(0, 5),  // 最大5つに制限
      user_intent: (parsed.user_intent || []).slice(0, 3)
    };
  } catch (error: any) {
    console.warn(`     ⚠️  Unified AI processing failed: ${error.message.substring(0, 100)}`);

    // レート制限エラーの場合は再スローして処理を停止
    if (checkRateLimitError(error)) {
      throw error;
    }

    // その他のエラーの場合のみフォールバック: 基本的な匿名化のみ
    console.warn(`     ⚠️  Using fallback processing (anonymization only, no AI fields)`);
    return {
      anonymizedText: anonymizeText(input.sourceText || '', input.mediaType),
      processedTranscript: input.transcript ? anonymizeText(input.transcript.substring(0, input.transcriptCharLimit || 12000), 'youtube') : undefined,
      ai_title: `${input.mediaType === 'twitter' ? 'Twitter' : 'YouTube'} Post`,
      summary: 'Content processing failed. Manual review required.',
      ai_tags: [],
      user_intent: []
    };
  }
}

