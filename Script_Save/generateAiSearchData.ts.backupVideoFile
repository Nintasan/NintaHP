/**
 * Upload video file to Google Cloud Storage and return GCS URI
 * @param localFilePath Local file path to upload
 * @param destinationName Destination file name in GCS (optional, auto-generated if not provided)
 * @returns GCS URI (gs://bucket-name/file-name) or null if upload failed
 */
async function uploadVideoToGCS(localFilePath: string, destinationName?: string): Promise<string | null> {
  if (!storage || !gcsBucket) {
    console.log('     ⚠️  GCS not configured, skipping upload');
    return null;
  }

  try {
    const fileName = destinationName || `video_${Date.now()}_${path.basename(localFilePath)}`;
    const bucket = storage.bucket(gcsBucket);
    const file = bucket.file(fileName);

    console.log(`     ☁️  Uploading to GCS: ${fileName}...`);
    await bucket.upload(localFilePath, {
      destination: fileName,
      metadata: {
        contentType: 'video/mp4',
        metadata: {
          uploadedAt: new Date().toISOString(),
          source: 'live2dtree-ai-search'
        }
      }
    });

    const gcsUri = `gs://${gcsBucket}/${fileName}`;
    console.log(`     ✅ Uploaded to GCS: ${gcsUri}`);
    return gcsUri;
  } catch (error: any) {
    console.error(`     ❌ GCS upload failed: ${error.message}`);
    return null;
  }
}

/**
 * Delete video file from Google Cloud Storage
 * @param gcsUri GCS URI (gs://bucket-name/file-name)
 */
async function deleteVideoFromGCS(gcsUri: string): Promise<void> {
  if (!storage || !gcsBucket) return;

  try {
    // Extract file name from gs://bucket-name/file-name
    const fileName = gcsUri.replace(`gs://${gcsBucket}/`, '');
    const bucket = storage.bucket(gcsBucket);
    await bucket.file(fileName).delete();
    console.log(`     🗑️  Deleted from GCS: ${fileName}`);
  } catch (error: any) {
    console.warn(`     ⚠️  GCS deletion failed: ${error.message}`);
  }
}

