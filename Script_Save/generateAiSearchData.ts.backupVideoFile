async function saveChunk(conn: mysql.Connection, postId: string, index: number, text: string, media: string, source: string, type: string, extra: any = {}) {
  // タイムスタンプを抽出
  const timestamps = extractTimestamps(text);

  // テキストからタイムスタンプを除去
  const cleanedText = removeTimestamps(text);

  // metadataにタイムスタンプ情報を追加
  const metadata = {
    media,
    source,
    type,
    ...extra,
    timestamps: timestamps.length > 0 ? timestamps : undefined
  };

  await conn.query(
    `INSERT INTO post_chunks (id, post_id, chunk_index, chunk_text, metadata, chunk_media, chunk_source, chunk_type) VALUES (?, ?, ?, ?, ?, ?, ?, ?)`,
    [uuid.v7(), postId, index, cleanedText, JSON.stringify(metadata), media, source, type]
  );
}

function createChunks(text: string, size: number = 600): string[] {
  if (text.length <= size) return [text];
  const chunks: string[] = []; let pos = 0;
  while (pos < text.length) {
    let end = pos + size;
    if (end >= text.length) { chunks.push(text.slice(pos).trim()); break; }
    const search = text.slice(pos, end); const breakChars = ['。', '.', '!', '?', '\n', '、', '，', '；'];
    let breakPos = -1;
    for (let i = search.length - 1; i >= Math.max(0, search.length - 100); i--) { if (breakChars.includes(search[i])) { breakPos = pos + i + 1; break; } }
    if (breakPos === -1) { for (let i = search.length - 1; i >= Math.max(0, search.length - 100); i--) { if (search[i] === ' ') { breakPos = pos + i + 1; break; } } }
    if (breakPos === -1) breakPos = end;
    const chunk = text.slice(pos, breakPos).trim(); if (chunk) chunks.push(chunk);
    pos = breakPos;
  }
  return chunks.filter(c => c.length > 0);
}

function splitIntoChunksWithOverlap(text: string, maxLength: number = 600, overlapLength: number = 75): string[] {
  if (text.length <= maxLength) return [text];
  const chunks: string[] = []; let currentPos = 0;
  while (currentPos < text.length) {
    let endPos = currentPos + maxLength;
    if (endPos >= text.length) { chunks.push(text.slice(currentPos).trim()); break; }
    const searchText = text.slice(currentPos, endPos); const breakChars = ['.', '!', '?', '\n'];
    let breakPos = -1;
    for (let i = searchText.length - 1; i >= Math.max(0, searchText.length - 100); i--) { if (breakChars.includes(searchText[i])) { breakPos = currentPos + i + 1; break; } }
    if (breakPos === -1) { const punctuation = [',', ';', ' ']; for (let i = searchText.length - 1; i >= Math.max(0, searchText.length - 100); i--) { if (punctuation.includes(searchText[i])) { breakPos = currentPos + i + 1; break; } } }
    if (breakPos === -1) breakPos = endPos;
    const chunk = text.slice(currentPos, breakPos).trim(); if (chunk) chunks.push(chunk);
    let overlapStart = breakPos; let sentenceCount = 0;
    for (let i = breakPos - 1; i >= currentPos && sentenceCount < 2; i--) { if (breakChars.includes(text[i])) { sentenceCount++; if (sentenceCount === 1 || sentenceCount === 2) overlapStart = i + 1; } if (breakPos - i > 100) break; }
    const overlapSize = breakPos - overlapStart;
    if (overlapSize >= 50 && overlapSize <= 100) currentPos = overlapStart; else if (overlapSize > 100) currentPos = breakPos - 100; else currentPos = breakPos;
  }
  return chunks.filter(c => c.length > 0);
}

