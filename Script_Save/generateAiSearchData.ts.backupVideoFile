/**
 * APIの種類に応じて適切なリクエストを送信する
 */
async function callGenerateContent(model: any, parts: any[], debugLabel: string = '') {
  if (usingPaidAPI) {
    // Vertex AI形式: { contents: [{ role: 'user', parts: [...] }] }
    const request = {
      contents: [{ role: 'user', parts: parts }]
    };

    // デバッグ: videoMetadataを含むリクエストをログ出力
    if (parts.some(p => p.videoMetadata)) {
      const videoMetadata = parts.find(p => p.videoMetadata)?.videoMetadata;
      console.log(`     🔍 ${debugLabel} Request videoMetadata:`, JSON.stringify(videoMetadata));
    }

    return await model.generateContent(request);
  } else {
    // AI Studio (Free) 形式: [part1, part2, ...]
    return await model.generateContent(parts);
  }
}

/**
 * Geminiのレスポンスからテキストを安全に取得する
 */
function getTextFromResponse(result: any): string {
  if (usingPaidAPI) {
    // Vertex AI SDKのレスポンス構造
    return result?.response?.candidates?.[0]?.content?.parts?.[0]?.text || '';
  } else {
    // AI Studio SDKのレスポンス構造
    return typeof result?.response?.text === 'function' ? result.response.text() : '';
  }
}

/**
 * APIレスポンスから使用量情報を抽出してコストを計算
 */
function trackUsageAndCost(result: any, videoSeconds: number = 0, images: number = 0, logPrefix: string = '', samplingFps: number = 1): number {
  if (!usingPaidAPI) return 0; // 無料版はコスト計算しない

  let inputTokens = 0;
  let outputTokens = 0;

  try {
    if (usingPaidAPI) {
      // Vertex AI: usageMetadata
      const usage = result?.response?.usageMetadata;
      inputTokens = usage?.promptTokenCount || 0;
      outputTokens = usage?.candidatesTokenCount || 0;
    } else {
      // AI Studio: usageMetadata
      const usage = result?.response?.usageMetadata;
      inputTokens = usage?.promptTokenCount || 0;
      outputTokens = usage?.candidatesTokenCount || 0;
    }
  } catch (e) {
    console.warn('     ⚠️  Failed to extract usage metadata');
  }

  // コスト計算
  const inputCost = (inputTokens / 1_000_000) * PRICING.inputTokensPer1M;
  const outputCost = (outputTokens / 1_000_000) * PRICING.outputTokensPer1M;

  // 動画はトークンとしてカウント（既に inputTokens に含まれている可能性があるため追加しない）
  // videoSeconds パラメータは参考情報として記録のみ
  const imageCost = images * PRICING.imagePer1024x1024;
  const totalCost = inputCost + outputCost + imageCost;

  // 📊 詳細ログ出力: トークン使用量とコスト分析
  if (inputTokens > 0 || outputTokens > 0) {
    // サンプリングを考慮した期待トークン数
    // 例: 36分 × 0.0833fps = 180フレーム → 180 × 258 tok/frame = 46,440トークン
    const expectedVideoTokens = videoSeconds > 0 ? Math.round(videoSeconds * samplingFps * PRICING.videoTokensPerSecond) : 0;
    const tokensPerSecond = videoSeconds > 0 ? (inputTokens / videoSeconds).toFixed(1) : 'N/A';
    const effectiveFps = videoSeconds > 0 ? (inputTokens / (videoSeconds * PRICING.videoTokensPerSecond)).toFixed(4) : 'N/A';

    console.log(`     ${logPrefix}📊 Token Usage:`);
    console.log(`        Input:  ${inputTokens.toLocaleString()} tokens (${tokensPerSecond} tok/sec, effective ${effectiveFps}fps)`);
    console.log(`        Output: ${outputTokens.toLocaleString()} tokens`);
    if (videoSeconds > 0) {
      console.log(`        Video:  ${videoSeconds.toFixed(0)}sec × ${samplingFps.toFixed(4)}fps (expected ~${expectedVideoTokens.toLocaleString()} tokens)`);
      const efficiency = expectedVideoTokens > 0 ? ((inputTokens / expectedVideoTokens) * 100).toFixed(1) : 'N/A';
      console.log(`        Efficiency: ${efficiency}% of expected tokens (${inputTokens <= expectedVideoTokens * 1.1 ? 'optimized✓' : 'needs check'})`);
    }
    console.log(`        Cost:   ${formatCost(totalCost)}`);
  }

  // セッション合計に加算
  sessionCost.inputTokens += inputTokens;
  sessionCost.outputTokens += outputTokens;
  sessionCost.videoSeconds += videoSeconds;
  sessionCost.images += images;
  sessionCost.totalCostUSD += totalCost;

  return totalCost;
}

/**
 * コスト情報をフォーマットして表示
 */
function formatCost(costUSD: number): string {
  if (costUSD === 0) return '$0.00 (¥0)';

  const jpy = costUSD * 150; // 1ドル=150円で換算

  if (costUSD < 0.0001) {
    // 0.01セント未満: マイクロセント表示
    return `$${costUSD.toFixed(6)} (${(costUSD * 100).toFixed(4)}¢, ¥${jpy.toFixed(4)})`;
  }
  if (costUSD < 0.01) {
    // 1セント未満: セント表示
    return `$${costUSD.toFixed(4)} (${(costUSD * 100).toFixed(2)}¢, ¥${jpy.toFixed(2)})`;
  }
  if (costUSD < 1) {
    // 1ドル未満: セント表示を追加
    return `$${costUSD.toFixed(4)} (${(costUSD * 100).toFixed(1)}¢, ¥${jpy.toFixed(1)})`;
  }
  // 1ドル以上
  return `$${costUSD.toFixed(2)} (¥${jpy.toFixed(0)})`;
}

