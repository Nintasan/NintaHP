/**
 * Geminiモデルを取得（無料版 or Vertex AI有料版）
 */
function getGeminiModel() {
  const { GoogleGenerativeAI } = require('@google/generative-ai');

  // 有料版に切り替え済みの場合
  if (usingPaidAPI && process.env.GOOGLE_APPLICATION_CREDENTIALS) {
    const { VertexAI } = require('@google-cloud/vertexai');

    let projectId = process.env.VERTEX_AI_PROJECT_ID;
    let location = process.env.VERTEX_AI_LOCATION || 'us-central1';

    if (!projectId) {
      try {
        const credPath = process.env.GOOGLE_APPLICATION_CREDENTIALS!;
        const credentials = JSON.parse(fs.readFileSync(credPath, 'utf8'));
        projectId = credentials.project_id;
      } catch (error: any) {
        throw new Error(`Failed to read project ID from credentials file: ${error.message}`);
      }
    }

    const vertexAI = new VertexAI({
      project: projectId,
      location: location,
    });

    return vertexAI.getGenerativeModel({ model: GEMINI_MODEL_PAID });
  }

  // デフォルト: 無料版API
  const genAI = new GoogleGenerativeAI(process.env.GEMINI_API_KEY!);
  return genAI.getGenerativeModel({ model: GEMINI_MODEL_FREE });
}

function checkRateLimitError(error: any): boolean {
  const errorMessage = error.message || '';
  const errorString = JSON.stringify(error);

  const rateLimitPatterns = [
    '429 Too Many Requests',
    'Quota exceeded',
    'quota exceeded',
    'rate limit',
    'Rate limit',
  ];

  return rateLimitPatterns.some(pattern =>
    errorMessage.includes(pattern) || errorString.includes(pattern)
  );
}

async function handleRateLimitError(error: any, context: string): Promise<boolean> {
  if (!checkRateLimitError(error)) return false;

  // レート制限エラーカウント
  rateLimitState.consecutiveErrors++;
  rateLimitState.lastErrorTime = Date.now();

  if (usingPaidAPI) {
    // 有料版APIもレート制限に達した場合: 自動待機して継続
    const waitMinutes = Math.min(rateLimitState.consecutiveErrors * 2, 10); // 2分, 4分, 6分... 最大10分
    const waitMs = waitMinutes * 60 * 1000;

    console.warn(`\n${'='.repeat(70)}`);
    console.warn(`⚠️  VERTEX AI (PAID) API RATE LIMIT REACHED`);
    console.warn(`${'='.repeat(70)}`);
    console.warn(`Context: ${context}`);
    console.warn(`Consecutive errors: ${rateLimitState.consecutiveErrors}`);
    console.warn(`⏰ Auto-retry: Waiting ${waitMinutes} minutes before continuing...`);
    console.warn(`💡 Processing will automatically resume at ${new Date(Date.now() + waitMs).toLocaleTimeString()}`);
    console.warn(`${'='.repeat(70)}\n`);

    // 待機
    await sleep(waitMs);

    // スリープ時間を延長
    rateLimitState.currentSleepTime = Math.min(
      rateLimitState.currentSleepTime * 1.5,
      rateLimitState.maxSleepTime
    );

    console.log(`🔄 Resuming processing... (Sleep time increased to ${(rateLimitState.currentSleepTime / 1000).toFixed(0)}s)\n`);
    return false; // 処理を続行
  }

  if (process.env.GOOGLE_APPLICATION_CREDENTIALS) {
    let projectId = process.env.VERTEX_AI_PROJECT_ID;
    if (!projectId) {
      try {
        const credPath = process.env.GOOGLE_APPLICATION_CREDENTIALS;
        const credentials = JSON.parse(fs.readFileSync(credPath, 'utf8'));
        projectId = credentials.project_id;
      } catch (error: any) {}
    }

    if (projectId) {
      console.warn(`\n${'='.repeat(70)}`);
      console.warn(`⚠️  GEMINI FREE API RATE LIMIT REACHED`);
      console.warn(`${'='.repeat(70)}`);
      console.warn(`Context: ${context}`);
      console.warn('🔄 Vertex AI 有料版APIに自動切り替えします...');
      console.warn(`💰 有料版APIを使用します（pay-per-use）`);
      console.warn(`${'='.repeat(70)}\n`);

      usingPaidAPI = true;
      return false; // 処理を続行
    }
  }

  console.error(`\n${'='.repeat(70)}`);
  console.error(`❌ GEMINI FREE API RATE LIMIT REACHED`);
  console.error('スクリプトを自動停止します。');
  console.error(`${'='.repeat(70)}\n`);
  rateLimitReached = true;
  return true;
}

