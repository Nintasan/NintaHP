async function analyzeTwitterVideoWithSegmentation(videoUrl: string, postText: string = ''): Promise<{ analysis: string | null; cost: number; cleanup?: () => Promise<void> }> {
  const axios = (await import('axios')).default;
  let tempFilePath: string | null = null;
  let uploadedFile: any = null;
  let totalCost = 0;

  try {
    console.log(`     📥 Downloading Twitter video...`);
    const response = await axios.get(videoUrl, { responseType: 'arraybuffer', timeout: 60000 });
    const videoData = Buffer.from(response.data);

    // 🛡️ ファイル形式検証 (マジックバイト検証)
    const headerStr = videoData.slice(0, 20).toString('utf-8');
    if (headerStr.includes('#EXTM3U')) {
      console.warn(`     ⚠️  Video URL points to an HLS playlist (.m3u8), not a video file. Skipping.`);
      return null;
    }
    if (headerStr.toLowerCase().includes('<!doctype') || headerStr.toLowerCase().includes('<html')) {
      console.warn(`     ⚠️  Download failed (received an HTML error page instead of video). Skipping.`);
      return null;
    }

    const isMp4 = videoData.length >= 8 && videoData.slice(4, 8).toString('utf-8') === 'ftyp';
    const isGif = videoData.length >= 3 && videoData.slice(0, 3).toString('utf-8') === 'GIF';
    const isWebM = videoData.length >= 4 && videoData.slice(0, 4).toString('hex') === '1a45dfa3';

    if (!isMp4 && !isGif && !isWebM) {
      console.warn(`     ⚠️  Downloaded file is not a valid video/GIF. Skipping to prevent API errors.`);
      return null;
    }

    let detectedMimeType = 'video/mp4';
    let fileExt = '.mp4';
    if (isGif) { detectedMimeType = 'image/gif'; fileExt = '.gif'; }
    if (isWebM) { detectedMimeType = 'video/webm'; fileExt = '.webm'; }

    const tempDir = os.tmpdir();
    tempFilePath = path.join(tempDir, `twitter_video_${Date.now()}${fileExt}`);
    fs.writeFileSync(tempFilePath, videoData);

    const fileSizeMB = fs.statSync(tempFilePath).size / (1024 * 1024);
    console.log(`     ✅ Downloaded: ${fileSizeMB.toFixed(2)} MB (${detectedMimeType})`);
    
    const estimatedDuration = 60; // seconds

    if (estimatedDuration <= 180) {
      console.log(`     📹 Short video mode (≤3 min)`);

      const parts: any[] = [];
      let gcsUri: string | null = null;

      // 🌟 有料版API使用時はGCSを優先、無料版はFile APIを使用
      if (usingPaidAPI && storage && gcsBucket) {
        // GCSにアップロード（有料版API用）
        gcsUri = await uploadVideoToGCS(tempFilePath!);
        if (gcsUri) {
          parts.push({
            fileData: {
              mimeType: detectedMimeType,
              fileUri: gcsUri
            }
          });
        }
