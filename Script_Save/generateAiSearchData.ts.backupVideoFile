    const parts = [
      {
        fileData: {
          mimeType: isGcsUri ? mimeType : fileUriOrObject.mimeType,
          fileUri: isGcsUri ? fileUriOrObject : fileUriOrObject.uri
        },
        videoMetadata: {
          startOffset: `${segment.startTime}s`,
          endOffset: `${segment.endTime}s`,
          // Note: Gemini API may not fully honor very low fps values (e.g., <0.2)
          // Observed: requesting 0.1111fps often results in ~0.2fps effective sampling
          ...(segment.samplingFps ? { fps: segment.samplingFps } : {})
        }
      },
      { text: prompt }
    ];

    console.log(`     🔧 Using ${usingPaidAPI ? 'PAID 💰 (Vertex AI)' : 'FREE 🆓 (AI Studio)'} API for YouTube segment ${segment.index + 1}`);

    let responseText = '';
    const logPrefix = `[Seg ${segment.index + 1}/${totalDuration ? Math.ceil(totalDuration / (segment.endTime - segment.startTime)) : '?'}] `;

    if (usingPaidAPI) {
      // 有料版APIを試みる
      try {
        const model = getGeminiModel();
        const result = await callGenerateContent(model, parts, `Segment ${segment.index + 1}`);
        segmentCost += trackUsageAndCost(result, segmentDuration, 0, logPrefix, segment.samplingFps || 1);
        responseText = getTextFromResponse(result);
      } catch (paidError: any) {
        console.warn(`     ⚠️  Paid API failed, falling back to free: ${paidError.message.substring(0, 100)}`);
        // フォールバック: 無料版を試す
        const { GoogleGenerativeAI } = require('@google/generative-ai');
        const genAI = new GoogleGenerativeAI(process.env.GEMINI_API_KEY!);
        const videoModel = genAI.getGenerativeModel({ model: GEMINI_MODEL_FREE });
        const result = await videoModel.generateContent(parts);
        segmentCost += trackUsageAndCost(result, segmentDuration, 0, logPrefix);
        responseText = typeof result?.response?.text === 'function' ? result.response.text() : '';
      }
    } else {
      // 無料版API使用
      const { GoogleGenerativeAI } = require('@google/generative-ai');
      const genAI = new GoogleGenerativeAI(process.env.GEMINI_API_KEY!);
      const videoModel = genAI.getGenerativeModel({ model: GEMINI_MODEL_FREE });
      const result = await videoModel.generateContent(parts);
      segmentCost += trackUsageAndCost(result, segmentDuration, 0, logPrefix);
      responseText = typeof result?.response?.text === 'function' ? result.response.text() : '';
    }

    try {
      const jsonMatch = responseText.match(/\{[\s\S]*\}/);
      if (jsonMatch) {
        const chunks = JSON.parse(jsonMatch[0]).chunks?.map((c: any) => c.content) || [responseText];
        return { chunks, cost: segmentCost };
      }
    } catch (e) {}
    return { chunks: [responseText], cost: segmentCost };
  } catch (error: any) {
    console.warn(`     ⚠️  YouTube segment analysis failed: ${error.message.substring(0, 100)}`);
    return { chunks: [], cost: segmentCost };
  }
}

