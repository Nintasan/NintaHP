/**
 * タイムスタンプをテキストから抽出する
 * 対応フォーマット:
 * - 構造化: MM:SS | Title | Description
 * - レガシー: MM:SS, HH:MM:SS, [MM:SS], (MM:SS)
 */
interface TimestampInfo {
  timestamp: string;  // 元のタイムスタンプ文字列
  seconds: number;    // 秒数
  title: string;      // タイムスタンプ周辺の短いタイトル
}

function extractTimestamps(text: string): TimestampInfo[] {
  if (!text) return [];

  const timestamps: TimestampInfo[] = [];

  // 🌟 新フォーマット: MM:SS | Title | Description
  const structuredRegex = /(\d{1,2}):(\d{2})(?::(\d{2}))?\s*\|\s*([^|]+?)\s*\|/g;
  let match;

  while ((match = structuredRegex.exec(text)) !== null) {
    const hours = match[3] ? parseInt(match[1]) : 0;
    const minutes = match[3] ? parseInt(match[2]) : parseInt(match[1]);
    const seconds = match[3] ? parseInt(match[3]) : parseInt(match[2]);
    const totalSeconds = hours * 3600 + minutes * 60 + seconds;

    const title = match[4].trim();

    timestamps.push({
      timestamp: match[1] + ':' + match[2] + (match[3] ? ':' + match[3] : ''),
      seconds: totalSeconds,
      title: title || 'Section'
    });
  }

  // 構造化フォーマットが見つかった場合は、それを優先して返す
  if (timestamps.length > 0) {
    return timestamps;
  }

  // 🔄 レガシーフォーマット対応（後方互換性）
  const legacyRegex = /(?:\[|\()?(\d{1,2}):(\d{2})(?::(\d{2}))?(?:\]|\))?/g;

  while ((match = legacyRegex.exec(text)) !== null) {
    const hours = match[3] ? parseInt(match[1]) : 0;
    const minutes = match[3] ? parseInt(match[2]) : parseInt(match[1]);
    const seconds = match[3] ? parseInt(match[3]) : parseInt(match[2]);
    const totalSeconds = hours * 3600 + minutes * 60 + seconds;

    // タイムスタンプ後のテキストから短いタイトルを抽出
    const afterTimestamp = text.substring(match.index + match[0].length).trim();
    const titleMatch = afterTimestamp.match(/^[\s\-–—:]*([^\n]{1,50})/);
    let title = titleMatch ? titleMatch[1].trim() : '';

    // タイトルを45文字程度に制限（単語境界で切る）
    if (title.length > 45) {
      const truncated = title.substring(0, 45);
      const lastSpace = truncated.lastIndexOf(' ');
      title = lastSpace > 35 ? truncated.substring(0, lastSpace) : truncated;
    }

    timestamps.push({
      timestamp: match[0],
      seconds: totalSeconds,
      title: title || 'Section'
    });
  }

  return timestamps;
}

/**
 * テキストからタイムスタンプを除去する
 * - 構造化フォーマット: "MM:SS | Title | " を削除
 * - レガシーフォーマット: "MM:SS " を削除
 */
function removeTimestamps(text: string): string {
  if (!text) return text;

  // 構造化フォーマットのタイムスタンプとタイトルを削除: "MM:SS | Title | " → ""
  let cleaned = text.replace(/(\d{1,2}):(\d{2})(?::(\d{2}))?\s*\|\s*[^|]+?\s*\|\s*/g, '');

  // レガシーフォーマットのタイムスタンプを削除
  cleaned = cleaned.replace(/(?:\[|\()?(\d{1,2}):(\d{2})(?::(\d{2}))?(?:\]|\))?\s*/g, '');

  return cleaned;
}

interface ChunkSegment {
  index: number;
  startTime: number;
  endTime: number;
  charLimit: number;
  isFirstChunk: boolean;
  type: 'mechanical';
  samplingFps?: number; // サンプリングFPS (1fps / samplingRate)
}

function calculateMechanicalSegments(durationSeconds: number): ChunkSegment[] {
  if (durationSeconds <= 180) return [];

  // 🎯 サンプリングレート: Math.max(1, Math.floor(durationSec / 1800)) 秒に1回
  // 30分(1800秒)なら1秒に1回、3時間(10800秒)なら6秒に1回
  const samplingRate = Math.max(1, Math.floor(durationSeconds / 1800));

  // サンプリングFPS: 1fps / samplingRate
  // 例: samplingRate=12 → 1/12 fps ≈ 0.0833 fps (12秒に1フレーム)
  // Note: Gemini API appears to have a minimum effective fps around 0.2, regardless of requested value
  // For very long videos, consider using longer segments or startOffset/endOffset without fps parameter
  const samplingFps = 1 / samplingRate;

  // セグメント長: 30分以下は3分、それ以上は動的に調整
  const durationMinutes = durationSeconds / 60;
  let stepMinutes: number;

  if (durationMinutes <= 30) {
    stepMinutes = 3; // 標準: 3分セグメント
  } else {
    // 長尺動画: サンプリングレートに応じてセグメントを拡大
    stepMinutes = Math.max(3, 3 * samplingRate);
  }

  const stepSeconds = Math.round(stepMinutes * 60);
  const totalSegments = Math.ceil(durationSeconds / stepSeconds);
  const segments: ChunkSegment[] = [];

  console.log(`  📊 Video analysis strategy: ${Math.floor(durationMinutes)}min video, sampling every ${samplingRate}s (${samplingFps.toFixed(4)}fps), ${totalSegments} segments of ${stepMinutes}min each`);

  for (let i = 0; i < totalSegments; i++) {
    segments.push({
      index: i,
      startTime: i * stepSeconds,
      endTime: Math.min((i + 1) * stepSeconds, durationSeconds),
      charLimit: 2400,
      isFirstChunk: i === 0,
      type: 'mechanical',
      samplingFps: samplingFps
    });
  }
  return segments;
}
function secondsToTimeString(seconds: number): string { return `${Math.floor(seconds / 60).toString().padStart(2, '0')}:${(seconds % 60).toString().padStart(2, '0')}`; }
function isTwitterUrl(url: string): boolean { return url.includes('twitter.com') || url.includes('x.com'); }
function isYouTubeUrl(url: string): boolean { return url.includes('youtube.com') || url.includes('youtu.be'); }
